  // Universal Input & Platform Detection
  const urlInput = document.getElementById('url-input');
  const protocolDot = document.getElementById('protocol-dot');
  const protocolStatus = document.getElementById('protocol-status');
  const resolveBtn = document.getElementById('resolve-trigger');
  const pasteBtn = document.getElementById('paste-trigger');
  const platformChips = document.querySelectorAll('.platform-chip');
  const sampleBtns = document.querySelectorAll('.sample-btn');

  function detectPlatform(val) {
    const lower = val.toLowerCase();
    platformChips.forEach(chip => {
      chip.className = 'platform-chip px-3 py-1 rounded-lg bg-white border border-orange-200/90 text-orange-900 font-label-sm text-label-sm shadow-sm transition-all duration-200 hover:border-orange-400 hover:shadow-orange-sm cursor-default';
    });

    if (!val.trim()) {
      protocolDot.className = 'w-2.5 h-2.5 rounded-full bg-orange-500 shadow-[0_0_8px_#ea580c]';
      protocolStatus.textContent = 'Awaiting URL...';
      return;
    }

    let detected = null;
    if (lower.includes('instagram.com')) detected = 'instagram';
    else if (lower.includes('tiktok.com')) detected = 'tiktok';
    else if (lower.includes('youtube.com') || lower.includes('youtu.be')) detected = 'youtube';
    else if (lower.includes('reddit.com')) detected = 'reddit';
    else if (lower.includes('twitter.com') || lower.includes('x.com')) detected = 'x';
    else if (lower.includes('threads.net')) detected = 'threads';
    else if (lower.includes('pinterest.com')) detected = 'pinterest';

    if (detected) {
      protocolDot.className = 'w-2.5 h-2.5 rounded-full bg-amber-500 shadow-[0_0_8px_#f59e0b]';
      protocolStatus.textContent = detected.toUpperCase() + ' DETECTED';
      const target = document.querySelector(`.platform-chip[data-platform="${detected}"]`);
      if (target) {
        target.className = 'platform-chip px-3 py-1 rounded-lg bg-orange-600 text-white font-label-sm text-label-sm shadow-orange-sm font-bold border border-orange-600 transition-all duration-200 cursor-default';
      }
    } else {
      protocolDot.className = 'w-2.5 h-2.5 rounded-full bg-orange-700 shadow-[0_0_8px_#c2410c]';
      protocolStatus.textContent = 'Generic Stream Manifest';
    }
  }

  urlInput.addEventListener('input', (e) => {
    detectPlatform(e.target.value);
  });

  pasteBtn.addEventListener('click', async () => {
    try {
      const text = await navigator.clipboard.readText();
      urlInput.value = text;
      detectPlatform(text);
      urlInput.focus();
    } catch (err) {
      urlInput.focus();
    }
  });

  sampleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-url');
      urlInput.value = url;
      detectPlatform(url);
      switchState('resolving');
      setTimeout(() => {
        switchState('ready');
      }, 1200);
    });
  });

  resolveBtn.addEventListener('click', () => {
    const val = urlInput.value.trim();
    if (!val) {
      urlInput.focus();
      return;
    }
    if (val.includes('private') || val.includes('restricted')) {
      switchState('error');
    } else {
      switchState('resolving');
      setTimeout(() => {
        switchState('ready');
      }, 1400);
    }
  });

  // State Inspector Switcher
  const stateTabs = document.querySelectorAll('.state-tab');
  const stateViews = document.querySelectorAll('.state-view');

  function switchState(stateName) {
    stateTabs.forEach(tab => {
      if (tab.getAttribute('data-state') === stateName) {
        tab.className = 'state-tab px-4 py-2 rounded-xl font-label-md text-label-md transition-all bg-gradient-to-r from-orange-600 to-amber-600 text-white shadow-[0_2px_10px_rgba(234,88,12,0.35)] font-bold';
      } else {
        tab.className = 'state-tab px-4 py-2 rounded-xl font-label-md text-label-md transition-all text-orange-950/70 hover:text-orange-600 hover:bg-orange-50 font-medium';
      }
    });

    stateViews.forEach(view => {
      if (view.id === `state-${stateName}`) {
        view.classList.remove('hidden');
        view.classList.add('flex');
      } else {
        view.classList.add('hidden');
        view.classList.remove('flex');
      }
    });
  }

  stateTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      switchState(tab.getAttribute('data-state'));
    });
  });

  // FAQ Accordion
  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    const btn = item.querySelector('.faq-btn');
    const content = item.querySelector('.faq-content');
    const icon = item.querySelector('.faq-icon');
    btn.addEventListener('click', () => {
      const isHidden = content.classList.contains('hidden');
      // close all
      faqItems.forEach(other => {
        other.querySelector('.faq-content').classList.add('hidden');
        other.querySelector('.faq-icon').style.transform = 'rotate(0deg)';
      });
      if (isHidden) {
        content.classList.remove('hidden');
        icon.style.transform = 'rotate(180deg)';
      }
    });
  });
