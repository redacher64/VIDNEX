<script>
  let activeState = 'ready';
  let selectedFormat = {
    id: 'opt-a',
    size: '48.2 MB',
    label: 'MP4 1080p HD (60fps)'
  };
  let processingTimer = null;

  function switchState(state) {
    activeState = state;
    const views = ['ready', 'processing', 'private', 'invalid'];
    views.forEach(v => {
      const el = document.getElementById('state-' + v + '-view');
      const btn = document.getElementById('tab-' + v);
      if (el) {
        if (v === state) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      }
      if (btn) {
        if (v === state) {
          btn.className = 'state-tab-btn flex items-center gap-1.5 px-space-md py-1.5 rounded-xl font-label-sm text-label-sm text-on-primary bg-primary shadow-md shadow-orange-500/30 transition-all whitespace-nowrap';
        } else {
          btn.className = 'state-tab-btn flex items-center gap-1.5 px-space-md py-1.5 rounded-xl font-label-sm text-label-sm text-on-surface-variant hover:text-orange-600 hover:bg-orange-50 transition-all whitespace-nowrap';
        }
      }
    });

    if (state === 'processing') {
      simulateProgress();
    } else {
      if (processingTimer) clearInterval(processingTimer);
    }
  }

  function selectStream(id, size, label) {
    selectedFormat = { id, size, label };
    const radio = document.getElementById(id);
    if (radio) radio.checked = true;

    document.querySelectorAll('.stream-option').forEach(el => {
      el.classList.remove('bg-orange-50/80', 'border-2', 'border-orange-500', 'shadow-sm', 'shadow-orange-500/10');
      el.classList.add('bg-surface-container-low', 'border', 'border-orange-100');
    });

    const activeLabel = radio.closest('.stream-option');
    if (activeLabel) {
      activeLabel.classList.remove('bg-surface-container-low', 'border', 'border-orange-100');
      activeLabel.classList.add('bg-orange-50/80', 'border-2', 'border-orange-500', 'shadow-sm', 'shadow-orange-500/10');
    }

    const btnText = document.getElementById('download-btn-text');
    if (btnText) {
      btnText.innerText = `Initialize Download (${size})`;
    }
  }

  function startDownloadProcess() {
    switchState('processing');
  }

  function simulateProgress() {
    let pct = 20;
    const bar = document.getElementById('processing-progress-bar');
    const label = document.getElementById('progress-percent');
    if (processingTimer) clearInterval(processingTimer);

    processingTimer = setInterval(() => {
      pct += Math.floor(Math.random() * 8) + 4;
      if (pct >= 99) {
        pct = 99;
        clearInterval(processingTimer);
      }
      if (bar) bar.style.width = pct + '%';
      if (label) label.innerText = pct + '%';
    }, 280);
  }

  function completeProcessingSim() {
    showToast('Demux completed! Media stream dispatched.');
    setTimeout(() => {
      switchState('ready');
    }, 800);
  }

  function cancelPipeline() {
    showToast('Demux process aborted by operator.', 'cancel');
    switchState('ready');
  }

  function resolveStream() {
    const input = document.getElementById('stream-url-input');
    const val = input.value.trim().toLowerCase();

    if (!val || !val.startsWith('http')) {
      switchState('invalid');
      return;
    }
    if (val.includes('private') || val.includes('restricted')) {
      switchState('private');
      return;
    }
    switchState('ready');
    showToast('Target stream resolved in 19ms.');
  }

  function clearAndFocusInput() {
    const input = document.getElementById('stream-url-input');
    input.value = '';
    input.focus();
  }

  async function pasteClipboard() {
    try {
      if (navigator.clipboard) {
        const text = await navigator.clipboard.readText();
        if (text) {
          document.getElementById('stream-url-input').value = text;
          showToast('URL pasted from clipboard');
          resolveStream();
        }
      } else {
        showToast('Clipboard access unavailable');
      }
    } catch (e) {
      showToast('Clipboard permission denied');
    }
  }

  function restoreSampleLink() {
    const input = document.getElementById('stream-url-input');
    input.value = 'https://www.instagram.com/reel/C3b8Z9pLqXa/';
    switchState('ready');
    showToast('Verified sample reel loaded');
  }

  function copyMetadata() {
    const meta = JSON.stringify({
      title: "Architectural brutalism in Kyoto: Sound of falling rain",
      creator: "@spatial_arch",
      bitrate: "18.4 Mbps",
      fps: 60,
      res: "1080x1920",
      codecs: ["avc1.64002a", "mp4a.40.2"]
    }, null, 2);

    navigator.clipboard?.writeText(meta);
    showToast('Raw JSON metadata copied to clipboard');
  }

  function addToBatchQueue() {
    showToast(`Added [${selectedFormat.label}] to queue`);
  }

  function clearBatchQueue() {
    const tbody = document.getElementById('batch-queue-body');
    const pill = document.getElementById('queue-count-pill');
    if (tbody) {
      tbody.innerHTML = `<tr><td colspan="6" class="py-space-lg text-center text-on-surface-variant font-label-sm text-label-sm">No active jobs in session queue.</td></tr>`;
    }
    if (pill) pill.innerText = '0 Jobs Cached';
    showToast('Session batch queue cleared');
  }

  function downloadAllZip() {
    showToast('Packaging 4 streams into ZIP archive (268.4 MB)...');
  }

  function triggerFileSave(fileName) {
    showToast(`Dispatching ${fileName} to browser save stream`);
  }

  function toggleVideoPlayback(btn) {
    const icon = btn.querySelector('.material-symbols-outlined');
    if (icon.innerText === 'play_arrow') {
      icon.innerText = 'pause';
      showToast('Live preview playback streaming...');
    } else {
      icon.innerText = 'play_arrow';
      showToast('Playback paused');
    }
  }

  function showToast(text, iconName = 'check_circle') {
    const toast = document.getElementById('toast');
    const toastText = document.getElementById('toast-text');
    const toastIcon = document.getElementById('toast-icon');

    if (toast && toastText) {
      toastText.innerText = text;
      if (toastIcon) toastIcon.innerText = iconName;
      toast.classList.remove('translate-y-24', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');

      setTimeout(() => {
        toast.classList.remove('translate-y-0', 'opacity-100');
        toast.classList.add('translate-y-24', 'opacity-0');
      }, 2500);
    }
  }
