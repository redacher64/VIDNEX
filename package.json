{
  "name": "vidnex",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:og": "node scripts/generate-og.mjs",
    "build": "tsc && vite build && node scripts/prerender.mjs && node --experimental-strip-types scripts/verify-seo.mjs && node --experimental-strip-types scripts/check-og.mjs",
    "dev:cf": "vite build && wrangler dev",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.backend.json",
    "lint:backend": "tsc --noEmit -p tsconfig.backend.json",
    "test": "node --experimental-strip-types --test src/utils/urlDetector.test.ts tests/linkedin.test.ts",
    "indexnow": "node --experimental-strip-types scripts/indexnow.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "6.4.6",
    "wrangler": "^4.158.0"
  }
}
