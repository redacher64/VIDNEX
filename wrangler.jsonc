{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidnex",
  "main": "worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vidnex-db",
      "database_id": "087ec6de-586d-41eb-a47d-0eb7f6ceb9c9",
      "migrations_dir": "migrations"
    }
  ]
}
