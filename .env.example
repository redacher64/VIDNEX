# ==============================================================================
# VIDNEX MULTI-SERVICE & SELF-HOSTED CONFIGURATION
# ==============================================================================
# Optional Frontend API Base URL (leave empty on Vercel Services where `/api/(.*)`
# routes to `backend` on the same domain; set to `https://username-vidnex.hf.space`
# only if hosting the backend on a separate external domain).
# Note: Do NOT set BACKEND_URL manually — Vercel injects it via Service Bindings.
VITE_API_BASE_URL=

# Engine 1: TikWM API (https://www.tikwm.com/api/) Server-Side Key
TIKWM_API_KEY=fbef7469f068f8ee1493378b59468819

# Engine 2: BetterTwitFix / vxTwitter API (https://github.com/dylanpdx/BetterTwitFix)
BETTERTWITFIX_API_URL=https://api.vxtwitter.com

# Engine 3: Optional Base64-encoded Netscape cookies.txt for yt-dlp cloud IP bypass
COOKIES_TXT_BASE64=

# Optional AdSense Publisher ID
VITE_ADSENSE_CLIENT_ID=
