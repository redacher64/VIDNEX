# ==============================================================================
# VIDNEX CONFIGURATION (100% GRATUIT / SERVERLESS CLOUDFLARE PAGES)
# ==============================================================================

# Optionnel : URL personnalisée de l'API (laisser vide sur Cloudflare Pages où /api/
# est routé nativement par les Pages Functions du même domaine).
VITE_API_BASE_URL=

# Optionnel : Instance Cobalt personnalisée (si vous hébergez votre propre instance)
# Par défaut, VIDNEX interroge les instances publiques gratuites en fallback.
COBALT_API_URL=
COBALT_API_KEY=

# Optionnel : Identifiant éditeur Google AdSense (ex: ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID=
