# ==============================================================================
# VIDNEX SERVER-SIDE ENVIRONMENT VARIABLES (RAPIDAPI BRIDGE)
# ==============================================================================
# IMPORTANT: Never expose RAPIDAPI_KEY with a VITE_ prefix.
# Keep these variables strictly server-side in Vercel / Cloudflare Pages / .env

RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-scraper-stable-api.p.rapidapi.com
RAPIDAPI_UA=RapidAPI-Playground

# Optional secondary RapidAPI hosts for TikTok / Multi-platform extraction
RAPIDAPI_TIKTOK_HOST=tiktok-video-no-watermark2.p.rapidapi.com

# Optional client-side overrides
VITE_API_BASE_URL=
VITE_ADSENSE_CLIENT_ID=
